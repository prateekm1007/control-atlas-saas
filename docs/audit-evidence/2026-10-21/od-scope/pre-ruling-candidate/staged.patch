@@ -0,0 +1,165 @@
+"""OD-03/04/20 scope and coverage regression tests.
+
+These tests pin the reviewed scope only: LAW-130, LAW-155 and LAW-200 use
+the pLDDT >= 70 atom core for predicted structures. LAW-110 deliberately
+remains all-residue because the canonical register does not authorize a
+pLDDT scope for it. Experimental structures retain all atoms.
+"""
+import sys
+import os
+
+import numpy as np
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
+
+from tos.engine.adjudicator import AdjudicationInput, adjudicate_laws
+from tos.engine.tier1_measurements import Tier1Measurements
+from tos.ingestion.processor import Atom, ConfidenceProfile, Structure
+from tos.governance.station_sop import LAW_CANON
+
+
+def _atom(name, pos, seq, b_iso, chain="A", res_name="ALA"):
+    return Atom(
+        atom_name=name, element=name[0], pos=np.array(pos, dtype=float),
+        res_name=res_name, res_seq=seq, chain_id=chain,
+        insertion_code="", b_iso=b_iso,
+    )
+
+
+def _core_atoms(seq, count, b_iso):
+    base = [seq * 3, 0, 0]
+    atoms = [
+        _atom("N", base, seq, b_iso),
+        _atom("CA", [base[0] + 1, 0, 0], seq, b_iso),
+        _atom("C", [base[0] + 2, 0, 0], seq, b_iso),
+        _atom("CB", [base[0] + 0.5, 1, 0], seq, b_iso),
+    ]
+    if seq == 10:
+        atoms[2] = _atom("C", [100, 0, 0], seq, b_iso)
+    return atoms
+
+
+def _low_atoms(seq, count, b_iso):
+    base = [seq * 3, 0, 0]
+    names = ["N", "CA", "C", "O", "CB", "CG", "CD", "CE", "CZ",
+             "OH", "NH1", "NH2"]
+    return [
+        _atom(names[i], [base[0] + i * 0.5, 2, 0], seq, b_iso)
+        for i in range(count)
+    ]
+
+
+def _structure(core_count, low_count, low_atoms_per_residue=4,
+               experimental=False):
+    atoms = []
+    for seq in range(1, core_count + 1):
+        atoms.extend(_core_atoms(seq, 4, 90.0))
+    for seq in range(core_count + 1, core_count + low_count + 1):
+        atoms.extend(_low_atoms(seq, low_atoms_per_residue, 20.0))
+    method = "xray" if experimental else "predicted"
+    return Structure(
+        atoms=atoms, audit_id="TEST",
+        confidence=ConfidenceProfile([], experimental, method),
+    )
+
+
+def _all_passing():
+    return {
+        lid: {
+            "observed": LAW_CANON[lid]["threshold"] * 0.5,
+            "deviation": "0.0", "sample": 100, "status": "PASS",
+        }
+        for lid in LAW_CANON
+    }
+
+
+def test_core_scope_is_40_of_64_atoms_for_predicted():
+    struct = _structure(10, 6)
+    results, coverage, _ = Tier1Measurements.run_full_audit(struct)
+
+    assert coverage == 62.5
+    assert results["LAW-105"]["residue_coverage"] == 62.5
+    assert results["LAW-105"]["atom_coverage"] == 62.5
+    assert results["LAW-105"]["sample_core_atoms"] == 40
+    assert results["LAW-105"]["sample_atoms"] == 64
+    for lid in ("LAW-130", "LAW-155", "LAW-200"):
+        assert results[lid]["sample"] == 40
+
+
+def test_experimental_scope_retains_all_atoms():
+    struct = _structure(10, 6, experimental=True)
+    results, coverage, _ = Tier1Measurements.run_full_audit(struct)
+
+    assert coverage == 100.0
+    assert results["LAW-105"]["atom_coverage"] == 100.0
+    assert results["LAW-105"]["sample_core_atoms"] == 64
+    for lid in ("LAW-130", "LAW-155", "LAW-200"):
+        assert results[lid]["sample"] == 64
+
+
+def test_law_110_remains_all_residue_scoped():
+    struct = _structure(10, 6)
+    results, _, _ = Tier1Measurements.run_full_audit(struct)
+
+    assert results["LAW-110"]["sample"] == 15
+    assert results["LAW-110"]["observed"] == 1
+
+
+def test_atom_coverage_gate_can_fail_while_residue_coverage_passes():
+    struct = _structure(12, 4, low_atoms_per_residue=12)
+    results, coverage, _ = Tier1Measurements.run_full_audit(struct)
+
+    assert results["LAW-105"]["residue_coverage"] == 75.0
+    assert results["LAW-105"]["status"] == "PASS"
+    assert coverage == 50.0
+    assert results["LAW-105"]["atom_coverage"] == 50.0
+
+    adjudication = adjudicate_laws(AdjudicationInput(
+        raw_measurements=results, coverage=coverage,
+        is_experimental=False, method_type="predicted",
+        architecture="NONE",
+    ))
+    assert adjudication.verdict == "INDETERMINATE"
+
+
+def test_empty_core_is_not_measured_not_pass():
+    struct = _structure(0, 4)
+    results, coverage, _ = Tier1Measurements.run_full_audit(struct)
+
+    assert coverage == 0.0
+    for lid in ("LAW-130", "LAW-155", "LAW-200"):
+        assert results[lid]["status"] == "NOT_MEASURED"
+        assert results[lid]["observed"] is None
+        assert results[lid]["sample"] == 0
+
+
+def test_heuristic_veto_cannot_veto_verdict():
+    measurements = _all_passing()
+    measurements["LAW-155"] = {
+        "observed": 0.1, "deviation": "999", "sample": 10, "status": "VETO",
+    }
+    adjudication = adjudicate_laws(AdjudicationInput(
+        raw_measurements=measurements, coverage=100.0,
+        is_experimental=False, method_type="predicted",
+        architecture="NONE",
+    ))
+    row = next(r for r in adjudication.law_rows if r["law_id"] == "LAW-155")
+    assert row["status"] == "FAIL (Advisory)"
+    assert row["method"] == "heuristic"
+    assert adjudication.verdict == "PASS"
+
+
+def test_law_130_is_still_deterministic():
+    measurements = _all_passing()
+    measurements["LAW-130"] = {
+        "observed": 99.0, "deviation": "999", "sample": 10, "status": "VETO",
+    }
+    adjudication = adjudicate_laws(AdjudicationInput(
+        raw_measurements=measurements, coverage=100.0,
+        is_experimental=False, method_type="predicted",
+        architecture="NONE",
+    ))
+    row = next(r for r in adjudication.law_rows if r["law_id"] == "LAW-130")
+    assert row["status"] == "VETO"
+    assert row["method"] == "deterministic"
+    assert adjudication.verdict == "VETO"
